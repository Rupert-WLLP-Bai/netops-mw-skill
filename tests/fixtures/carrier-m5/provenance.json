{
  "schema_version": 1,
  "license": "Apache-2.0",
  "origin": "Self-authored synthetic M5 service-delivery and change-review fixture templates and expected outcomes. No customer, subscriber, circuit, site, device, address, credential, vendor sample, real contract, or third-party test data are included.",
  "upstream_data_sources": [],
  "parser_libraries_reused": [],
  "source_contract": "Generic M2 telemetry-json-v1 and topology-json-v1 inputs, with source-qualified synthetic order, actual, criterion, measurement, calibration, mapping, and change declarations.",
  "boundary": "Scenario files contain developer-only source paths, row keys, and request templates. The harness materializes M2 runs and resolves logical IDs from evidence IDs actually emitted by the importer. The analyzer receives only resolved requests and checked run bundles. The separate oracle and raw source templates are never analyzer input; this directory separation is not an OS isolation boundary.",
  "synthetic_value_notice": "All numeric criteria, profile values, dates, and test results are fabricated solely to exercise source-backed comparisons. They are not universal thresholds, vendor requirements, or service recommendations.",
  "source_reference_rule": "Every evidence reference in requests/oracle is a logical `$row` marker resolved by the harness against emitted M2 evidence IDs. Staged equivalence source templates use `$ID`/`$RUN_ID` placeholders resolved from prerequisite emitted runs; no evidence IDs are inferred from decimal indices.",
  "case_descriptions": [
    {
      "case_id": "case-001",
      "intent": "Incomplete service order leaves required fields and criteria unverified."
    },
    {
      "case_id": "case-002",
      "intent": "Source-backed A-side VLAN differs from its approved design; no port or cause is inferred."
    },
    {
      "case_id": "case-003",
      "intent": "Source-backed A-side VRF differs from its approved design; no cross-VRF reachability is inferred."
    },
    {
      "case_id": "case-004",
      "intent": "Endpoint A actual evidence is deliberately bound to endpoint B topology and cannot be remapped by label."
    },
    {
      "case_id": "case-005",
      "intent": "A-to-B measured throughput is below its source-backed synthetic criterion."
    },
    {
      "case_id": "case-006",
      "intent": "Only A-to-B test evidence is requested; B-to-A remains independently unverified."
    },
    {
      "case_id": "case-007",
      "intent": "A required criterion method reference is absent; no method is guessed."
    },
    {
      "case_id": "case-008",
      "intent": "Post-change review omits approval, precheck, and postcheck evidence while technical test evidence is incomplete."
    },
    {
      "case_id": "case-009",
      "intent": "Complete positive control matches all 21 field targets and five capability criteria in both absolute directions, with distinct legitimate endpoint VLANs and required calibration evidence."
    },
    {
      "case_id": "case-010",
      "intent": "Complete pre-change draft includes a future planned window, current prechecks, approval state, rollback metadata, and sourced postcheck plans without future results."
    },
    {
      "case_id": "case-011",
      "intent": "Complete post-change review has approval chronology, same-point scoped pre/post checks, a mapped direction, and no execution or recovery claim."
    },
    {
      "case_id": "case-012",
      "intent": "Endpoint B actual configuration is absent despite the full approved field inventory and endpoint A evidence."
    },
    {
      "case_id": "case-013",
      "intent": "Approved criterion inventory includes an L3 MTU criterion omitted from the caller request."
    },
    {
      "case_id": "case-014",
      "intent": "A stale actual throughput sample is compared against a separately valid static design and criterion."
    },
    {
      "case_id": "case-015",
      "intent": "One static field target is outside its dated validity interval at the request reference time."
    },
    {
      "case_id": "case-016",
      "intent": "Calibration validity ends before the measured test window."
    },
    {
      "case_id": "case-017",
      "intent": "All technical field and test requirements pass, but a requested post-change review omits its required postcheck window end; acceptance remains blocked."
    }
  ],
