  "source_contract": "M2 generic telemetry-json-v1 and topology-json-v1 inputs, with explicit synthetic operator bindings and profile declarations.",
  "boundary": "Scenario source/config files and expected oracle are developer test inputs. The test harness renders sanitized M2 bundles and resolves a request for analysis; only the resolved request and sanitized runs are analyzer inputs. The oracle is read by tests separately and is never passed to the analyzer. Directory names do not provide operating-system isolation; the evaluator harness owns that boundary.",
  "case_descriptions": [
    {"case_id": "case-001", "intent": "Ordered profile-backed optical readings decline below a self-authored synthetic limit."},
    {"case_id": "case-002", "intent": "Ordered PON session states up/down/up support a scoped flap observation."},
    {"case_id": "case-003", "intent": "Profile-backed normal optical readings accompany a scoped Wi-Fi failure as counterevidence."},
    {"case_id": "case-004", "intent": "A stale LOS event and optical reading without a profile must not be treated as current faults."},
    {"case_id": "case-005", "intent": "A reset between FEC counter samples blocks its delta; a separate positive CRC increase remains neutral without an impact or profile."},
    {"case_id": "case-006", "intent": "An unverified service-to-resource relationship blocks attribution of an otherwise ordered PON up/down/up sequence."},
    {"case_id": "case-007", "intent": "A source-reported PPPoE rejection supports only an authentication observation."},
    {"case_id": "case-008", "intent": "AAA acceptance is counterevidence to a DHCP lease failure at the same scoped event time."},
    {"case_id": "case-009", "intent": "A directly scoped pool exhaustion observation supports a DHCP pool finding."},
    {"case_id": "case-010", "intent": "Explicit differing service VLAN labels support only a mapping discrepancy."},
    {"case_id": "case-011", "intent": "One-way application failure can be reported without claiming complete bidirectional health."},
    {"case_id": "case-012", "intent": "Unknown clock quality blocks interpretation of ordered-looking authentication and DHCP events."}
  ],
